# 复制为 .env.local 并填写。任意 OpenAI 兼容接口都可以。
# 不填 AI_API_KEY 也能用：会退回到规则提取。

# DeepSeek（默认）— 文字粘贴提取
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 通义千问 VL（阿里云百炼）— 截图提取，与上面 AI_* 分离
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# 也可把文字模型切到通义（可选，与截图 VL 无关）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 知识库根目录，默认是 workbench 的上一级目录
# KB_DIR=/path/to/your-knowledge-base

# 飞书多维表格直写（确认保存后：建行 → 上传附件 → update 附件字段）
# 鉴权用 user_access_token（对齐豆包 --as user），勿用 tenant 冒充成功。
LARK_APP_ID=
LARK_APP_SECRET=
# 推荐：直接放用户 token；过期后需手动更新，或配 refresh
LARK_USER_ACCESS_TOKEN=
# 可选：用 app id/secret 刷新用户 token（进程内缓存，不回写本文件）
LARK_REFRESH_TOKEN=
# 默认 Base / Table（可覆盖）
# LARK_BASE_TOKEN=TIlebbivOaXu73s05YXchV1XnPb
# LARK_TABLE_ID=tbltWWJaNx6bknQV
# 处理人多选（open_id），JSON 数组；勿把人名硬塞进 person 字段
# LARK_HANDLERS=[{"name":"张三","open_id":"ou_xxx"}]
