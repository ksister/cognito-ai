# 复制为 .env.local 并填写。任意 OpenAI 兼容接口都可以。
# 不填 AI_API_KEY 也能用：会退回到规则提取。

# DeepSeek（默认）— 文字粘贴提取
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 通义千问 VL（阿里云百炼）— 截图提取，与上面 AI_* 分离
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen3-vl-plus
# 最大输出 token。默认 32768，即 qwen3-vl-plus 官方最大输出长度。
# DASHSCOPE_VL_MAX_TOKENS=32768
# 请求超时，毫秒。默认 300000（5 分钟）。超时后请改用粘贴文字。
# DASHSCOPE_VL_TIMEOUT_MS=300000

# 也可把文字模型切到通义（可选，与截图 VL 无关）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 真实知识库放在仓库外的私有目录。第一次使用前把仓库里的 01-me/、templates/、prompts/ 复制过去。
# 不设时默认是 workbench 的上一级（本仓库）。见 README「真实数据放在哪」。
# KB_DIR=/absolute/path/to/private-knowledge-base
# 飞书列、单选选项、复制行顺序：把 workbench/config/feishu-table.example.json
# 复制为 $KB_DIR/config/feishu-table.json，按测试表「工作台粘贴」视图修改。
# 真实列名和选项不要提交进仓库。

# ——— 飞书多维表格直写（确认保存后：本地落盘 → 建行 → 上传附件）———
# 默认走本机 lark-cli OAuth（--as user），无需在聊天/ .env 手填 user token。
# 安装：npx @larksuite/cli@latest install
# 登录：lark-cli config init（按提示完成 OAuth）
# LARK_PUSH_MODE=cli
# 可选：自定义 CLI 路径（不在 PATH 时）
# LARK_CLI_PATH=C:\Users\你\.workbuddy\binaries\node\cli-connector-packages\node_modules\@larksuite\cli\bin\lark-cli.exe
# Base / Table 必填才会直写飞书。真实值只写 .env.local，不要写进本文件。
# LARK_BASE_TOKEN=<your_base_token>
# LARK_TABLE_ID=<your_table_id>
# 探测脚本专用测试表。必须和生产表 LARK_TABLE_ID 不同，脚本才会运行。
# 测试表若在另一个多维表格，另设 LARK_TEST_BASE_TOKEN；否则沿用上面的 LARK_BASE_TOKEN。
# LARK_TEST_TABLE_ID=<your_test_table_id>
# LARK_TEST_BASE_TOKEN=
# LARK_TEST_TEXT_FIELD=
# LARK_TEST_ATTACHMENT_FIELD=
# 处理人多选（open_id），JSON 数组；勿把人名硬塞进 person 字段
# LARK_HANDLERS=[{"name":"张三","open_id":"ou_xxx"}]

# —— 可选 API fallback（仅当 LARK_PUSH_MODE=api 时需要）——
# LARK_PUSH_MODE=api
# LARK_USER_ACCESS_TOKEN=
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REFRESH_TOKEN=
